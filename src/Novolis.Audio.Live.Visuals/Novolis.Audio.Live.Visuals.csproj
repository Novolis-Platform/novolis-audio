<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Novolis.Audio.Packaging.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Novolis.Audio.Live.Visuals</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Novolis.Audio.Live.Visuals</PackageId>
    <IsPackable>true</IsPackable>
    <Description>View-model projections and visual state helpers for Novolis Audio Live.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Audio.Analysis\Novolis.Audio.Analysis.csproj" />
    <ProjectReference Include="..\Novolis.Audio.Live\Novolis.Audio.Live.csproj" />
    <ProjectReference Include="..\Novolis.Audio.Patterns\Novolis.Audio.Patterns.csproj" />
  </ItemGroup>
</Project>
