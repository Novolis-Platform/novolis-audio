<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Novolis.Audio.Packaging.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Novolis.Audio.Live.Render</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Novolis.Audio.Live.Render</PackageId>
    <IsPackable>true</IsPackable>
    <Description>
      Basic NAudio oscillator synthesis for Novolis Audio Live (v0 waveforms; EffectKind ignored).
    </Description>
    <PackageTags>audio;live;synthesis;naudio;oscillator</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Audio.Live\Novolis.Audio.Live.csproj" />
    <ProjectReference Include="..\Novolis.Audio.Live.Visuals\Novolis.Audio.Live.Visuals.csproj" />
    <ProjectReference Include="..\Novolis.Audio.MusicTheory\Novolis.Audio.MusicTheory.csproj" />
    <ProjectReference Include="..\Novolis.Audio.Patterns\Novolis.Audio.Patterns.csproj" />
  </ItemGroup>
</Project>
