<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Novolis.Audio.Packaging.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Novolis.Audio.Live.Dsl</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Novolis.Audio.Live.Dsl</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Discoverable DSL helpers for Novolis Audio Live programs, instruments, and effects.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Audio.Live\Novolis.Audio.Live.csproj" />
    <ProjectReference Include="..\Novolis.Audio.MusicTheory\Novolis.Audio.MusicTheory.csproj" />
    <ProjectReference Include="..\Novolis.Audio.Patterns\Novolis.Audio.Patterns.csproj" />
  </ItemGroup>
</Project>
