<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Novolis.Audio.Packaging.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Novolis.Audio.MusicXml</RootNamespace>
    <AssemblyName>Novolis.Audio.MusicXml</AssemblyName>
    <PackageId>Novolis.Audio.MusicXml</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Strongly typed MusicXML 4 partwise I/O plus JSON interchange (MusicJSON mirror and Novolis Score JSON).</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>audio;musicxml;musicjson;score;notation;json;xml;interchange</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
