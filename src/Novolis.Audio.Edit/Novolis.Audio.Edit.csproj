<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Novolis.Audio.Packaging.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Novolis.Audio.Edit</RootNamespace>
    <AssemblyName>Novolis.Audio.Edit</AssemblyName>
    <PackageId>Novolis.Audio.Edit</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Lightweight multi-track arrangement editor (Music Maker / Audacity–style): library, tracks, fades, mix export.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>audio;edit;daw;arrangement;waveform;audacity;music-maker</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\Novolis.Audio.Core\Novolis.Audio.Core.csproj" />
  </ItemGroup>
</Project>
