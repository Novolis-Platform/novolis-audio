  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Novolis.Audio.Packaging.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Novolis.Audio.Live.Host</RootNamespace>
    <OutputType>Exe</OutputType>
    <PackageId>Novolis.Audio.Live.Host</PackageId>
    <IsPackable>false</IsPackable>
    <Description>Headless engine host for Novolis Audio Live IPC sessions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Audio.Live.Protocol\Novolis.Audio.Live.Protocol.csproj" />
    <ProjectReference Include="..\Novolis.Audio.Live\Novolis.Audio.Live.csproj" />
  </ItemGroup>
</Project>
