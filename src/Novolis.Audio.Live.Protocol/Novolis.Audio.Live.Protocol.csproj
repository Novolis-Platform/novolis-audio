<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Novolis.Audio.Packaging.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Novolis.Audio.Live.Protocol</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Novolis.Audio.Live.Protocol</PackageId>
    <IsPackable>true</IsPackable>
    <Description>MessagePack DTOs, IPC helpers, and REPL client for Novolis Audio Live.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Novolis.Transports.LocalIpc" />
    <ProjectReference Include="..\Novolis.Audio.Live\Novolis.Audio.Live.csproj" />
    <ProjectReference Include="..\Novolis.Audio.Live.Dsl\Novolis.Audio.Live.Dsl.csproj" />
  </ItemGroup>
</Project>
