<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Novolis.Audio.Packaging.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Novolis.Audio.Voice.Manuscript</RootNamespace>
    <AssemblyName>Novolis.Audio.Voice.Manuscript</AssemblyName>
    <PackageId>Novolis.Audio.Voice.Manuscript</PackageId>
    <IsPackable>true</IsPackable>
    <Description>
      Manuscript TTS: speech planning, voice-map YAML, Edge TTS synthesis, chapter audiobook pipeline,
      MP3 concat/M4B assemble, and selection speech preview.
    </Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Novolis.Audio.Voice.EdgeTts\Novolis.Audio.Voice.EdgeTts.csproj" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
